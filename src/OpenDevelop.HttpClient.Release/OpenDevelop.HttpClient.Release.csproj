<Project Sdk="LibreWPF.Sdk">
  <PropertyGroup>
    <OpenDevelopAddin>true</OpenDevelopAddin>
    <OpenDevelopAddinKind>InProcess</OpenDevelopAddinKind>
    <TargetFramework>net11.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>OpenDevelop.HttpClient</RootNamespace>
    <AssemblyName>OpenDevelop.HttpClient</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <UseWPF>true</UseWPF>
    <OutputPath>$(MSBuildProjectDirectory)/bin/odaddin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OpenDevelopAddinManifest>../OpenDevelop.HttpClient/OpenDevelop.HttpClient.addin</OpenDevelopAddinManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../OpenDevelop.HttpClient/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../OpenDevelop.HttpClient/Resources/Http.xshd" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../OpenDevelop.HttpClient/OpenDevelop.HttpClient.addin" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.6.0" />
  </ItemGroup>
</Project>
